# Copy to .env and fill in. docker-compose reads this file automatically.

# PostgreSQL connection string for the API, in .NET environment format.
# Replace the password with the real one. Keep SSL Mode=Require when connecting
# over the network; drop SSL only if you attach the API to the Supabase network
# and use the internal db hostname.
ConnectionStrings__DefaultConnection=Host=newofcdb.almutasim.site;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true
