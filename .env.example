# Copy to .env and fill in real values before running docker compose up.

# Password for the bundled PostgreSQL database. Required — docker-compose.yml
# no longer falls back to a default, so choose a strong, unique value here.
# The API connects to the internal `db` service automatically, so there is no
# external connection string to configure for local/docker-compose runs.
DB_PASSWORD=change-me-to-a-strong-unique-password
